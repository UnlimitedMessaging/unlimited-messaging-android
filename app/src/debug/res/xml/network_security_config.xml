<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow plain HTTP so the app can reach `pnpm dev`
     on the emulator host (10.0.2.2) or on the developer's LAN address. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
