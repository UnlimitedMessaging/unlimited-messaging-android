<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name" translatable="false">Unlimited Messaging</string>

    <!-- Sign-in -->
    <string name="sign_in_title">SMS gateway</string>
    <string name="sign_in_methods">Email, Google or GitHub, as on the website.</string>
    <string name="sign_in_explainer">Turn this phone into an SMS gateway for your account: messages queued from the API or the website are sent from this phone\'s SIM cards, and SMS it receives are forwarded to your account.</string>
    <string name="sign_in_button">Sign in</string>
    <string name="sign_in_error_network">Could not reach the server. Check your connection and try again.</string>
    <string name="sign_in_error_no_browser">No browser is installed to open the sign-in page.</string>
    <string name="sign_in_error_rejected">Sign-in was refused or cancelled.</string>
    <string name="sign_in_error_invalid_redirect">Sign-in could not be completed. Please try again.</string>
    <string name="sign_in_error_session_expired">Your session ended. Sign in again to resume the gateway.</string>

    <!-- Gateway -->
    <string name="gateway_title">Gateway</string>
    <string name="gateway_online">Connected. Queued messages are sent right away.</string>
    <string name="gateway_offline">Offline. Retrying automatically.</string>
    <string name="gateway_connecting">Connecting…</string>
    <string name="gateway_stopped">Stopped.</string>
    <string name="gateway_paused">Paused. Messages wait on the server until you switch it back on.</string>
    <string name="gateway_needs_setup">Allow SMS access below to start.</string>

    <!-- Setup -->
    <string name="setup_title">Setup</string>
    <string name="setup_done">Done</string>
    <string name="setup_sms">SMS and SIM access</string>
    <string name="setup_sms_detail">Required. Send queued SMS, forward received ones, list your SIM cards.</string>
    <string name="setup_battery">Unrestricted battery</string>
    <string name="setup_battery_detail">Recommended. Keeps Android from pausing the gateway when the screen is off.</string>
    <string name="setup_notifications">Notifications</string>
    <string name="setup_notifications_detail">Recommended. Shows the gateway status, and warns you if it stops.</string>
    <string name="setup_phone_numbers">Phone numbers</string>
    <string name="setup_phone_numbers_detail">Optional. Reads each SIM\'s number when your carrier provides it.</string>
    <string name="setup_manufacturer">Your phone\'s own battery manager</string>
    <string name="setup_manufacturer_detail">This manufacturer stops background apps more aggressively than Android does. Allow this app to auto-start and run in the background.</string>
    <string name="action_allow">Allow</string>
    <string name="action_open_settings">Open settings</string>
    <string name="action_open_guide">Guide</string>
    <string name="action_app_settings">App settings</string>

